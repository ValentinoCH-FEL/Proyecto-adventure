{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true, // Requerido por TypeORM
    "experimentalDecorators": true, // Requerido por TypeORM
    "moduleResolution": "node",
    "resolveJsonModule": true
    
 },
  "exclude": ["node_modules", "adventure-bus"] 

}